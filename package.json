{
  "name": "ssh-telegram-bot",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "esbuild server.ts --bundle --platform=node --target=node18 --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "gcp-build": "npm run build"
  },
  "dependencies": {
    "@types/ws": "^8.18.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "http-proxy": "^1.18.1",
    "qrcode": "^1.5.4",
    "ssh2": "^1.17.0",
    "undici": "^6.21.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/http-proxy": "^1.17.17",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/ssh2": "^1.15.5",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  },
  "engines": {
    "node": ">=18.17"
  }
}
